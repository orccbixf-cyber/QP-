-- ==========================================
-- 1. Auto Block (Safe Loop & Cooldown)
-- ==========================================
CreateToggle("Auto Block", Config.AutoBlock, function(val) Config.AutoBlock = val end)
CreateToggle("Show Block Range", Config.ShowBlockRange, function(val) Config.ShowBlockRange = val end)
CreateSlider("Block Distance", 5, 100, Config.BlockDistance, 0, function(val) Config.BlockDistance = val end)

local lastBlockTime = 0
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if hrp and Config.ShowBlockRange and Config.AutoBlock then
        CirclePart.Parent = workspace
        CirclePart.Size = Vector3.new(0.1, Config.BlockDistance * 2, Config.BlockDistance * 2)
        CirclePart.CFrame = hrp.CFrame * CFrame.Angles(0, 0, math.rad(90)) + Vector3.new(0, -2.5, 0)
    else
        CirclePart.Parent = nil
    end

    if not Config.AutoBlock or not hrp then return end

    if tick() - lastBlockTime >= 0.3 then
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") and obj ~= char then
                local dist = (hrp.Position - obj.HumanoidRootPart.Position).Magnitude
                if dist <= Config.BlockDistance then
                    lastBlockTime = tick()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                    break
                end
            end
        end
    end
end)

-- ==========================================
-- 2. Infinite Stamina (Safe Override)
-- ==========================================
CreateToggle("Infinite Stamina", Config.InfStamina, function(val) Config.InfStamina = val end)

task.spawn(function()
    while true do
        task.wait(0.2)
        if Config.InfStamina then
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    for _, child in pairs(char:GetChildren()) do
                        if child.Name:lower():find("stamina") and child:IsA("ValueBase") then
                            child.Value = child.MaxValue or 100
                        end
                    end
                    if char:GetAttribute("Stamina") then
                        char:SetAttribute("Stamina", 100)
                    end
                end
            end)
        end
    end
end)

-- ==========================================
-- 3. ESP (Clean Cleanup System)
-- ==========================================
local ESPFolder = Instance.new("Folder", ScreenGui)
ESPFolder.Name = "ESPFolder"

CreateToggle("ESP", Config.ESP, function(val) 
    Config.ESP = val 
    if not val then
        ESPFolder:ClearAllChildren()
    end
end)

task.spawn(function()
    while true do
        task.wait(0.5)
        if Config.ESP then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local hl = ESPFolder:FindFirstChild(player.Name)
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = player.Name
                        hl.FillColor = Color3.fromRGB(255, 50, 50)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.Parent = ESPFolder
                    end
                    hl.Adornee = player.Character
                end
            end
            for _, hl in pairs(ESPFolder:GetChildren()) do
                local p = Players:FindFirstChild(hl.Name)
                if not p or not p.Character then
                    hl:Destroy()
                end
            end
        end
    end
end)

